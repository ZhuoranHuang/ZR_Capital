# 复制为 .env 后填写；.env 不入库
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
# 实盘与模拟盘 token 分两个字段（App Key / App Secret 两种模式共用）：
LONGPORT_LIVE_ACCESS_TOKEN=
LONGPORT_PAPER_ACCESS_TOKEN=
# 旧字段名，LONGPORT_LIVE_ACCESS_TOKEN 的兼容别名；新部署直接用上面的新字段名，不必填这个
LONGPORT_ACCESS_TOKEN=
ZR_DATA_ROOT=./data_store
ZR_LIVE=0
ZR_SYMBOLS=SPY.US,QQQ.US,MU.US
