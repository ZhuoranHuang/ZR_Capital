<?xml version="1.0" encoding="UTF-8"?>
<!-- 每小时触发一次 deploy/sync_from_vps.sh；脚本自己用 TZ=Asia/Singapore 判断是否为 09 点且当天未同步。
     不依赖本机系统时区（本机被锁定为 US/Pacific）。
     安装：
       sed "s#__REPO__#$PWD#g" deploy/launchd/com.zr.sync-from-vps.plist > ~/Library/LaunchAgents/com.zr.sync-from-vps.plist
       launchctl unload ~/Library/LaunchAgents/com.zr.sync-from-vps.plist 2>/dev/null; launchctl load ~/Library/LaunchAgents/com.zr.sync-from-vps.plist
     手动立即同步：bash deploy/sync_from_vps.sh --now -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zr.sync-from-vps</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/deploy/sync_from_vps.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>ZR_DATA_ROOT</key>
        <string>__REPO__/data_store</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/zr-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/zr-sync.log</string>
</dict>
</plist>
