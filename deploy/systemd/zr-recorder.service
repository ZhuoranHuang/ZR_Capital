[Unit]
Description=ZR options recorder (one trading session)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ZR_Capital
EnvironmentFile=/home/ubuntu/ZR_Capital/.env
Environment=HOME=/home/ubuntu
# EnvironmentFile 会覆盖 Environment=（.env 里 ZR_DATA_ROOT=./data_store），
# 所以 ZR_DATA_ROOT 放到命令行 env，优先级最高
ExecStart=/usr/bin/env ZR_DATA_ROOT=/home/ubuntu/zr_data /home/ubuntu/.local/bin/uv run python -m zr.data.recorder
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
